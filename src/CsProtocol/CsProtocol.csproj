<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CsProtocol</AssemblyName>
    <RootNamespace>CsProtocol</RootNamespace>
    <PackageId>CsProtocol</PackageId>
    <Description>High-performance, allocation-conscious Minecraft Bedrock protocol codecs for .NET.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../cs-nbt/src/CsNbt/CsNbt.csproj" SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>
</Project>
